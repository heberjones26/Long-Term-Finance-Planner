# Copy to .env and fill in. .env is git-ignored.
MONARCH_EMAIL=you@example.com
MONARCH_PASSWORD=your-monarch-password

# Optional but recommended for scheduled/non-interactive runs.
# The base32 TOTP secret shown when you set up an authenticator app in Monarch
# (Settings -> Security). With this set, MFA is generated automatically and you
# never get prompted for a code. Leave blank to be prompted interactively.
MONARCH_MFA_SECRET=
